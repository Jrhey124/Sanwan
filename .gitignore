# ─── Secrets & credentials ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Encrypted data files ────────────────────────────────────────────────────
# All AES-256-GCM encrypted files — contain settings, notes, registry, tokens
data/*.enc
data/**/*.enc

# ─── Runtime data ────────────────────────────────────────────────────────────
# Operational data generated at runtime — never commit real user data
data/tasks/
data/notes/
data/schedules/
data/backups/
data/logs/
data/daemon-config.json

# Keep directory structure but not content
!data/tasks/.gitkeep
!data/notes/.gitkeep
!data/schedules/.gitkeep
!data/backups/.gitkeep
!data/logs/.gitkeep

# ─── Log files ───────────────────────────────────────────────────────────────
*.log
logs/

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Service unit files (generated by setup, platform-specific) ──────────────
sanwan-bot.service
sanwan-daemon.service
sanwan-webhook.service
sanwan-bot-task.xml
sanwan-daemon-task.xml
sanwan-webhook-task.xml

# ─── Test / diagnostic scripts ───────────────────────────────────────────────
scripts/

# ─── Build artifacts ─────────────────────────────────────────────────────────
dist/
build/
coverage/

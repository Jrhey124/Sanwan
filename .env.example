# Sanwan Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Run: npm run setup  (interactive wizard that builds .env for you)

# ─── Discord (required) ──────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_discord_server_id

# ─── Encryption (required) ───────────────────────────────────────────────────
# 64 hex characters (32 bytes). Run setup to auto-generate.
SETTINGS_KEY=
SETTINGS_PATH=./data/settings.enc

# ─── AI Provider (optional) ──────────────────────────────────────────────────
AI_PROVIDER=
AI_TOKEN=
AI_MODEL=

# ─── GitHub Integration (optional) ───────────────────────────────────────────
# Mode: none | polling | polling_pat | webhook
GITHUB_MODE=none
GITHUB_REPO=
GITHUB_PAT=
GITHUB_POLL_INTERVAL=60000
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PORT=3000
GITHUB_WEBHOOK_PATH=/webhook
